// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "disable_ai": false,
  "title_bar": {
    "button_layout": "platform_default"
  },
  "terminal": {
    "font_size": 14.0
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "project_panel": {
    "dock": "left",
    "auto_reveal_entries": true,
    "auto_fold_dirs": false
  },
  "search": {
    "include_ignored": true
  },
  "sticky_scroll": {
    "enabled": false
  },
  "minimap": {
    "show": "always"
  },
  "window_title_format": "${relativePath}${separator}${projectName}${separator}",
  "buffer_font_fallbacks": [
    "Fira Code",
    "Liberation Mono",
    "Ubuntu Mono",
    "DejaVu Sans Mono",
    "Droid Sans Fallback"
  ],
  "buffer_font_family": "JetBrains Mono",
  "file_types": {
    "markdown": [
      "SKILL.md"
    ],
    "groovy": [
      "*Jenkinsfile*"
    ],
    "dockerfile": [
      "Dockerfile.*"
    ],
    "pip-requirements": [
      "**/_requirements/*.txt",
      "**/requirements/*.txt"
    ],
    "toml": [
      "**/.chef/credentials",
      "**/.cinc/credentials"
    ],
    "ruby": [
      "Dangerfile",
      "Vagrantfile"
    ],
    "terragrunt": [
      "terragrunt.hcl.*",
      "terragrunt.hcl"
    ],
    "yaml": [
      ".yamllint"
    ],
    "plaintext": [
      ".tool-versions"
    ]
  },
  "show_whitespaces": "none",
  "wrap_guides": [
    80,
    100,
    120
  ],
  "hard_tabs": false,
  "icon_theme": "Zed (Default)",
  "base_keymap": "VSCode",
  "ui_font_size": 18.0,
  "buffer_font_size": 15.0,
  "theme": "JetBrains Islands Dark",
  "auto_install_extensions": {
    "dockerfile": true,
    "git-firefly": true,
    "html": true,
    "jetbrains-themes": true,
    "toml": true,
  },
}
